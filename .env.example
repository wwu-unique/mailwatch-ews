# ===== mailbox =====
# Hostname of your Exchange server that serves EWS over https
EWS_SERVER=mail.example.com
# NTLM login (DOMAIN\\user)
EWS_USERNAME=DOMAIN\\user
EWS_PASSWORD=
# Primary SMTP address of the mailbox
EWS_MAILBOX=user@example.com
# Exchange server build hint, e.g. 15.2.2562 (Exchange 2019). Optional.
#EWS_BUILD=15.2.2562

# ===== web UI =====
PANEL_USER=admin
PANEL_PASSWORD=change-me

# ===== database =====
POSTGRES_PASSWORD=change-me-pg

# ===== ports / storage =====
MAIL_PORT=18661
#MAX_STORAGE=100G
#TARGET_STORAGE=95G
